<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Veterinaria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">
                Veterinaria
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Clientes/Index">Clientes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Mascotas/Index">Mascotas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Veterinarios/Index">Veterinarios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Consultas/Index">Consultas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Recetas/Index">Recetas</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top text-muted py-3 mt-5">
        <div class="container text-center">
            Sistema de gestión veterinaria
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>