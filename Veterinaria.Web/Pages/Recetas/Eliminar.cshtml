@page "{id:int}"
@model Veterinaria.Web.Pages.Recetas.EliminarModel
@{
    ViewData["Title"] = "Eliminar Receta";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-3 text-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        Eliminar receta
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Error))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            @Model.Error
                        </div>

                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Regresar
                        </a>
                    }
                    
                    {
                        <div class="alert alert-warning">
                            ¿Estás seguro de que deseas eliminar esta receta?
                            Esta acción no se puede deshacer.
                        </div>

                        <div class="mb-4">

                            <p class="mb-1">
                                <strong>Número de receta:</strong>
                                #@Model.Receta.IdReceta
                            </p>

                            <p class="mb-1">
                                <strong>Fecha:</strong>
                                @Model.Receta.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </p>

                            <p class="mb-1">
                                <strong>Mascota:</strong>
                                @(Model.Mascota?.Nombre ?? "No disponible")
                            </p>

                            <p class="mb-1">
                                <strong>Consulta:</strong>
                                #@Model.Receta.IdConsulta
                            </p>

                            <p class="mb-0">
                                <strong>Indicaciones:</strong>
                                @(Model.Receta.IndicacionesGenerales ?? "Sin indicaciones")
                            </p>

                        </div>

                        <form method="post">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>
                                Eliminar receta
                            </button>

                            <a asp-page="./Index" class="btn btn-secondary">
                                Cancelar
                            </a>
                        </form>
                    }

                </div>
            </div>

        </div>
    </div>
</div>