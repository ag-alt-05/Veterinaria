@page
@model Veterinaria.Web.Pages.Recetas.IndexModel
@{
    ViewData["Title"] = "Recetas";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="text-uppercase fw-bold small text-success">
                Expedientes médicos
            </span>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-prescription2 me-2 text-success"></i>Recetas médicas
            </h2>
            <p class="text-muted mb-0">
                Consulta y administra las recetas médicas de las mascotas.
            </p>
        </div>

        <a asp-page="Nuevo" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i>
            Nueva receta
        </a>
    </div>

    <!-- MENSAJE -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BUSCADOR -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row g-2">
                    <div class="col-md-10">
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-search"></i>
                            </span>
                            <input asp-for="Buscar"
                                   class="form-control"
                                   placeholder="Buscar por mascota, veterinario o número de receta..." />
                        </div>
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-outline-success">
                            Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Listado de recetas</h5>
                <span class="badge bg-success">
                    @Model.Recetas.Count registros
                </span>
            </div>

            @if (Model.Recetas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Receta</th>
                                <th>Fecha</th>
                                <th>Mascota</th>
                                <th>Veterinario</th>
                                <th>Indicaciones</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var receta in Model.Recetas)
                            {
                                var consulta = Model.Consultas.FirstOrDefault(
                                    c => c.IdConsulta == receta.IdConsulta);

                                var mascota = consulta == null
                                    ? null
                                    : Model.Mascotas.FirstOrDefault(
                                        m => m.IdMascota == consulta.IdMascota);

                                var veterinario = consulta == null
                                    ? null
                                    : Model.Veterinarios.FirstOrDefault(
                                        v => v.IdVeterinario == consulta.IdVeterinario);

                                <tr>
                                    <td>
                                        <span class="fw-bold text-success">
                                            #@receta.IdReceta
                                        </span>
                                    </td>

                                    <td>
                                        @receta.Fecha.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (mascota != null)
                                        {
                                            <div class="fw-semibold">
                                                <i class="bi bi-heart-pulse text-success me-1"></i>
                                                @mascota.Nombre
                                            </div>
                                            <small class="text-muted">
                                                @mascota.Especie
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No disponible</span>
                                        }
                                    </td>

                                    <td>
                                        @if (veterinario != null)
                                        {
                                            <span>
                                                Dr. @veterinario.Nombre @veterinario.ApellidoPaterno
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No disponible</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(receta.IndicacionesGenerales))
                                        {
                                            var indicaciones = receta.IndicacionesGenerales;

                                            <span>
                                                @(indicaciones.Length > 45
                                                    ? indicaciones.Substring(0, 45) + "..."
                                                    : indicaciones)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin indicaciones</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-page="Detalle"
                                               asp-route-id="@receta.IdReceta"
                                               class="btn btn-sm btn-outline-info"
                                               title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-page="Editar"
                                               asp-route-id="@receta.IdReceta"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Editar receta">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <a asp-page="Eliminar"
                                               asp-route-id="@receta.IdReceta"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Eliminar receta">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-prescription2 display-3 text-muted"></i>
                    <h5 class="fw-bold mt-3">No hay recetas registradas</h5>
                    <p class="text-muted mb-3">
                        Todavía no existen recetas médicas o no se encontraron coincidencias.
                    </p>
                    <a asp-page="Nuevo" class="btn btn-success">
                        <i class="bi bi-plus-circle me-1"></i>
                        Registrar primera receta
                    </a>
                </div>
            }

        </div>
    </div>

</div>