@page
@model Veterinaria.Web.Pages.Consultas.IndexModel
@{
    ViewData["Title"] = "Consultas";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-uppercase fw-bold small text-success">Administración</span>
            <h2 class="fw-bold mb-1">Consultas</h2>
            <p class="text-muted mb-0">Administra el historial de consultas médicas de las mascotas.</p>
        </div>

        <a asp-page="./Nuevo" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-2"></i>
            Nueva consulta
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BÚSQUEDA -->
    <div class="card clientes-busqueda border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">

                <div class="col-lg-8">
                    <label class="form-label fw-semibold">Buscar consulta</label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="buscar"
                               value="@Model.Buscar"
                               class="form-control"
                               placeholder="Mascota, veterinario o diagnóstico..." />
                    </div>
                </div>

                <div class="col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        Buscar
                    </button>

                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        Limpiar
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- TABLA DE CONSULTAS -->
    <div class="card clientes-tabla border-0 shadow-sm">

        <div class="card-header bg-transparent border-0 px-4 pt-4">
            <h5 class="fw-bold mb-1">
                <i class="bi bi-clipboard2-pulse-fill me-2 text-success"></i>
                Historial de consultas
            </h5>

            <p class="text-muted small mb-0">
                Registro de las atenciones médicas realizadas.
            </p>
        </div>

        <div class="card-body px-4 pb-4">

            @if (Model.Consultas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Mascota</th>
                                <th>Veterinario</th>
                                <th>Motivo</th>
                                <th>Diagnóstico</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var consulta in Model.Consultas)
                            {
                                var mascota = Model.Mascotas.FirstOrDefault(
                                    m => m.IdMascota == consulta.IdMascota);

                                var veterinario = Model.Veterinarios.FirstOrDefault(
                                    v => v.IdVeterinario == consulta.IdVeterinario);

                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @consulta.Fecha.ToString("dd/MM/yyyy")
                                        </div>
                                        <small class="text-muted">
                                            @consulta.Fecha.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @(mascota?.Nombre ?? "Mascota no encontrada")
                                        </div>
                                        <small class="text-muted">
                                            @(mascota?.Especie ?? "")
                                        </small>
                                    </td>

                                    <td>
                                        @if (veterinario != null)
                                        {
                                            <span>
                                                @veterinario.Nombre @veterinario.ApellidoPaterno
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No disponible</span>
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(consulta.MotivoConsulta)
                                            ? "Sin especificar"
                                            : consulta.MotivoConsulta)
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(consulta.Diagnostico))
                                        {
                                            var diagnostico = consulta.Diagnostico.Length > 45
                                                ? consulta.Diagnostico[..45] + "..."
                                                : consulta.Diagnostico;

                                            @diagnostico
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pendiente</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                                            <a asp-page="./Detalle"
                                               asp-route-id="@consulta.IdConsulta"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Ver detalles de la consulta">
                                                <i class="bi bi-eye me-1"></i>
                                                Detalles
                                            </a>

                                            <a asp-page="./Editar"
                                               asp-route-id="@consulta.IdConsulta"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Editar consulta">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Editar
                                            </a>

                                            <a asp-page="./Eliminar"
                                               asp-route-id="@consulta.IdConsulta"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Eliminar consulta">
                                                <i class="bi bi-trash me-1"></i>
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="clientes-vacio text-center py-5">
                    <i class="bi bi-clipboard2-pulse display-4 text-muted"></i>

                    @if (!string.IsNullOrWhiteSpace(Model.Buscar))
                    {
                        <h5 class="fw-bold mt-3">No se encontraron consultas</h5>

                        <p class="text-muted mb-3">
                            No hay resultados que coincidan con tu búsqueda.
                        </p>

                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            Limpiar búsqueda
                        </a>
                    }
                    else
                    {
                        <h5 class="fw-bold mt-3">No hay consultas registradas</h5>

                        <p class="text-muted mb-3">
                            Cuando registres una consulta, aparecerá en este apartado.
                        </p>

                        <a asp-page="./Nuevo" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>
                            Registrar primera consulta
                        </a>
                    }
                </div>
            }

        </div>
    </div>

</div>