@page
@model Veterinaria.Web.Pages.Clientes.DetalleModel

@{
    ViewData["Title"] = "Detalle del Cliente";
}

<h2>Detalle del cliente</h2>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">
        @Model.Error
    </div>
}

@if (Model.Cliente.IdCliente > 0)
{
    <div class="card border-0 shadow-sm p-4 mb-4">
        <dl class="row">

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">
                @Model.Cliente.Nombre
                @Model.Cliente.ApellidoPaterno
                @Model.Cliente.ApellidoMaterno
            </dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Cliente.Telefono</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.Cliente.Correo</dd>

            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">@Model.Cliente.Direccion</dd>

        </dl>

        <div>
            <a asp-page="/Mascotas/Nueva"
               class="btn btn-success">Registrar mascota</a>

            <a asp-page="./Editar"
               asp-route-id="@Model.Cliente.IdCliente"
               class="btn btn-primary">Editar</a>

            <a asp-page="./Index"
               class="btn btn-secondary">Regresar</a>
        </div>
    </div>

    <h3 class="mb-3">Mascotas del cliente</h3>

    @if (Model.Mascotas.Count == 0)
    {
        <div class="alert alert-info">
            Este cliente todavía no tiene mascotas registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Sexo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var mascota in Model.Mascotas)
                    {
                        <tr>
                            <td>@mascota.Nombre</td>
                            <td>@mascota.Especie</td>
                            <td>@mascota.Raza</td>
                            <td>@mascota.Sexo</td>
                            <td>
                                <a asp-page="/Mascotas/Detalle"
                                   asp-route-id="@mascota.IdMascota"
                                   class="btn btn-sm btn-info">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}