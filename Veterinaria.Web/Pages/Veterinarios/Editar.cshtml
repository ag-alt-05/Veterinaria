@page
@model Veterinaria.Web.Pages.Veterinarios.EditarModel
@{
    ViewData["Title"] = "Editar Veterinario";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <span class="text-uppercase fw-bold small text-success">Administración / Veterinarios</span>
        <h2 class="fw-bold mb-1">Editar veterinario</h2>
        <p class="text-muted mb-0">Modifica la información del veterinario seleccionado.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">
            @Model.Error
        </div>
    }

    <!-- FORMULARIO -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form method="post">

                <input type="hidden" asp-for="Veterinario.IdVeterinario" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h5 class="fw-bold mb-3">
                    <i class="bi bi-person-badge-fill me-2 text-success"></i>
                    Información personal
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Veterinario.Nombre" class="form-label fw-semibold">Nombre</label>
                        <input asp-for="Veterinario.Nombre" class="form-control" />
                        <span asp-validation-for="Veterinario.Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Veterinario.ApellidoPaterno" class="form-label fw-semibold">Apellido paterno</label>
                        <input asp-for="Veterinario.ApellidoPaterno" class="form-control" />
                        <span asp-validation-for="Veterinario.ApellidoPaterno" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Veterinario.ApellidoMaterno" class="form-label fw-semibold">Apellido materno</label>
                        <input asp-for="Veterinario.ApellidoMaterno" class="form-control" />
                        <span asp-validation-for="Veterinario.ApellidoMaterno" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Veterinario.Cedula" class="form-label fw-semibold">Cédula profesional</label>
                        <input asp-for="Veterinario.Cedula" class="form-control" />
                        <span asp-validation-for="Veterinario.Cedula" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Veterinario.Especialidad" class="form-label fw-semibold">Especialidad</label>
                        <input asp-for="Veterinario.Especialidad" class="form-control" />
                        <span asp-validation-for="Veterinario.Especialidad" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    <i class="bi bi-telephone-fill me-2 text-success"></i>
                    Información de contacto
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Veterinario.Telefono" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Veterinario.Telefono" class="form-control" />
                        <span asp-validation-for="Veterinario.Telefono" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Veterinario.Correo" class="form-label fw-semibold">Correo electrónico</label>
                        <input asp-for="Veterinario.Correo" class="form-control" />
                        <span asp-validation-for="Veterinario.Correo" class="text-danger"></span>
                    </div>

                </div>

                <div class="mt-4 d-flex flex-wrap gap-2">

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Guardar cambios
                    </button>

                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}