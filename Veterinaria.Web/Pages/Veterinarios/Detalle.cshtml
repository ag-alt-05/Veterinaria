@page
@model Veterinaria.Web.Pages.Veterinarios.DetalleModel

@{
    ViewData["Title"] = "Detalle del Veterinario";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <span class="text-uppercase fw-bold small text-success">Administración / Veterinarios</span>
        <h2 class="fw-bold mb-1">Detalle del veterinario</h2>
        <p class="text-muted mb-0">Consulta la información del veterinario seleccionado.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">
            @Model.Error
        </div>
    }

    @if (Model.Veterinario.IdVeterinario > 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <!-- INFORMACIÓN PERSONAL -->
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-person-badge-fill me-2 text-success"></i>
                    Información personal
                </h5>

                <dl class="row">

                    <dt class="col-sm-3">Nombre completo</dt>
                    <dd class="col-sm-9">
                        @Model.Veterinario.Nombre
                        @Model.Veterinario.ApellidoPaterno
                        @Model.Veterinario.ApellidoMaterno
                    </dd>

                    <dt class="col-sm-3">Cédula profesional</dt>
                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(Model.Veterinario.Cedula)
                            ? "No registrada"
                            : Model.Veterinario.Cedula)
                    </dd>

                    <dt class="col-sm-3">Especialidad</dt>
                    <dd class="col-sm-9">
                        @Model.Veterinario.Especialidad
                    </dd>

                </dl>

                <hr class="my-4" />

                <!-- INFORMACIÓN DE CONTACTO -->
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-telephone-fill me-2 text-success"></i>
                    Información de contacto
                </h5>

                <dl class="row">

                    <dt class="col-sm-3">Teléfono</dt>
                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(Model.Veterinario.Telefono)
                            ? "No registrado"
                            : Model.Veterinario.Telefono)
                    </dd>

                    <dt class="col-sm-3">Correo electrónico</dt>
                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(Model.Veterinario.Correo)
                            ? "No registrado"
                            : Model.Veterinario.Correo)
                    </dd>

                </dl>

                <!-- ACCIONES -->
                <div class="mt-4 d-flex flex-wrap gap-2">

                    <a asp-page="./Editar"
                       asp-route-id="@Model.Veterinario.IdVeterinario"
                       class="btn btn-primary">
                        <i class="bi bi-pencil-square me-2"></i>
                        Editar
                    </a>

                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        Regresar
                    </a>

                </div>

            </div>
        </div>
    }

</div>