@page "{id:int}"
@model Veterinaria.Web.Pages.Veterinarios.EliminarModel
@{
    ViewData["Title"] = "Eliminar Veterinario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-3 text-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        Eliminar veterinario
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Error))
                    {
                        <div class="alert alert-danger">
                            @Model.Error
                        </div>

                        <a asp-page="./Index" class="btn btn-secondary">
                            Regresar
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            ¿Estás seguro de que deseas eliminar este veterinario?
                            Esta acción no se puede deshacer.
                        </div>

                        <div class="mb-4">

                            <p class="mb-1">
                                <strong>Nombre:</strong>
                                @Model.Veterinario.Nombre
                                @Model.Veterinario.ApellidoPaterno
                                @Model.Veterinario.ApellidoMaterno
                            </p>

                            <p class="mb-1">
                                <strong>Cédula profesional:</strong>
                                @(Model.Veterinario.Cedula ?? "No registrada")
                            </p>

                            <p class="mb-1">
                                <strong>Especialidad:</strong>
                                @Model.Veterinario.Especialidad
                            </p>

                            <p class="mb-1">
                                <strong>Teléfono:</strong>
                                @(Model.Veterinario.Telefono ?? "No registrado")
                            </p>

                            <p class="mb-0">
                                <strong>Correo:</strong>
                                @(Model.Veterinario.Correo ?? "No registrado")
                            </p>

                        </div>

                        <form method="post">
                            <input type="hidden" name="id"
                                   value="@Model.Veterinario.IdVeterinario" />

                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i>
                                Eliminar
                            </button>

                            <a asp-page="./Index" class="btn btn-secondary">
                                Cancelar
                            </a>
                        </form>
                    }

                </div>
            </div>

        </div>
    </div>
</div>