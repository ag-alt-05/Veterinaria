@page
@model Veterinaria.Web.Pages.Mascotas.IndexModel

@{
    ViewData["Title"] = "Mascotas";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-uppercase fw-bold small text-success">Administración</span>
            <h2 class="fw-bold mb-1">Mascotas</h2>
            <p class="text-muted mb-0">Administra la información de los pacientes registrados.</p>
        </div>

        <a asp-page="./Nueva" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-2"></i>
            Nueva mascota
        </a>
    </div>

    <!-- MENSAJES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Model.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- TABLA DE MASCOTAS -->
    <div class="card mascotas-tabla border-0 shadow-sm">

        <div class="card-header bg-transparent border-0 px-4 pt-4">
            <h5 class="fw-bold mb-1">
                <i class="bi bi-heart-pulse-fill me-2 text-success"></i>
                Pacientes registrados
            </h5>
            <p class="text-muted small mb-0">
                Información de las mascotas y sus propietarios.
            </p>
        </div>

        <div class="card-body px-4 pb-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Especie</th>
                            <th>Raza</th>
                            <th>Sexo, si</th>
                            <th>Propietario</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var m in Model.Mascotas)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="mascota-icono">
                                            <i> <img width="17px" src="images/huella.png"  /></i>
                                        </span>
                                        <span class="fw-semibold">@m.Nombre</span>
                                    </div>
                                </td>

                                <td>@m.Especie</td>

                                <td>@m.Raza</td>

                                <td>@m.Sexo</td>

                                <td>
                                    <i class="bi bi-person me-2 text-muted"></i>
                                    @Model.NombrePropietario(m.IdCliente)
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center flex-wrap gap-1">

                                        <a asp-page="./Detalle"
                                           asp-route-id="@m.IdMascota"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-page="./Editar"
                                           asp-route-id="@m.IdMascota"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Editar mascota">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-page="./Eliminar"
                                           asp-route-id="@m.IdMascota"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Eliminar mascota">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            @if (!Model.Mascotas.Any())
            {
                <div class="mascotas-vacio text-center py-5">
                    <i class="bi bi-heart display-4 text-muted"></i>
                    <h5 class="fw-bold mt-3">No hay mascotas registradas</h5>
                    <p class="text-muted mb-0">
                        Cuando registres una mascota, aparecerá en esta lista.
                    </p>
                </div>
            }

        </div>
    </div>

</div>