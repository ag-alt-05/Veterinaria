@page
@model Veterinaria.Web.Pages.Mascotas.DetalleModel

@{
    ViewData["Title"] = "Detalle de Mascota";
}

<h2>Detalle de mascota</h2>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">
        @Model.Error
    </div>
}

@if (Model.Mascota.IdMascota > 0)
{
    <div class="card border-0 shadow-sm p-4">
        <dl class="row">

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Mascota.Nombre</dd>

            <dt class="col-sm-3">Propietario</dt>
            <dd class="col-sm-9">@Model.Propietario</dd>

            <dt class="col-sm-3">Especie</dt>
            <dd class="col-sm-9">@Model.Mascota.Especie</dd>

            <dt class="col-sm-3">Raza</dt>
            <dd class="col-sm-9">@Model.Mascota.Raza</dd>

            <dt class="col-sm-3">Sexo</dt>
            <dd class="col-sm-9">@Model.Mascota.Sexo</dd>

            <dt class="col-sm-3">Color / señas</dt>
            <dd class="col-sm-9">@Model.Mascota.Color</dd>

        </dl>

        <div>
            <a asp-page="./Editar"
               asp-route-id="@Model.Mascota.IdMascota"
               class="btn btn-primary">Editar</a>

            <a asp-page="./Index"
               class="btn btn-secondary">Regresar</a>
        </div>
    </div>
}