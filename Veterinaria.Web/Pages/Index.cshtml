@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- SECCIÓN PRINCIPAL -->
<section class="inicio-hero">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6 inicio-contenido">

                <span class="inicio-etiqueta">
                    <i class="bi bi-heart-pulse-fill me-2"></i>
                    Cuidamos lo que más te duele
                </span>

                <h1>
                    Clinica veterinaria en
                    <span>Ensenada</span>
                </h1>

                <p class="inicio-descripcion">
                    Cada mascota merece amor, atención y cuidados especiales.
                    Consultas, vacunas, cirugias, laboratorio, medicamentos, ultrasonidos y rayos X.
                </p>

                <div class="inicio-botones">
                    <a href="#servicios" class="btn btn-inicio-principal">
                        Conoce nuestros servicios
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <a href="#contacto" class="btn btn-inicio-secundario">
                        Agenda tu consulta
                    </a>
                </div>

                <div class="inicio-confianza">
                    <i class="bi bi-heart-fill"></i>
                    <span>Porque ellos también son parte de la familia.</span>
                </div>

            </div>
            <!--                  IMAGEN DE INICIO                          -->
            <div class="col-lg-6 inicio-imagen-contenedor">
                <div class="inicio-imagen-fondo"></div>

                <img src="~/images/mascota-principal.jpg"
                     alt="Mascota atendida con cariño"
                     class="inicio-imagen" />

                <div class="inicio-imagen-etiqueta">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>Cuidado y bienestar para tu mascota</span>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- SECCIÓN DE SERVICIOS -->
<section class="inicio-servicios" id="servicios">
    <div class="container">

        <div class="text-center servicios-encabezado">
            <span class="servicios-etiqueta">NUESTRO COMPROMISO</span>
            <h2>Todo por su bienestar</h2>
            <p>
                Trabajamos para ofrecer una atención organizada y un mejor
                seguimiento de cada mascota con servicios de alta calidad.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="servicio-card">
                    <div class="servicio-icono">
                        <i class="bi bi-heart-pulse"></i>
                    </div>
                    <h3>Atención veterinaria</h3>
                    <p>
                        El cuidado de la salud de tu mascota es una de nuestras
                        principales prioridades.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="servicio-card">
                    <div class="servicio-icono">
                        <i class="bi bi-clipboard2-heart"></i>
                    </div>
                    <h3>Seguimiento y cuidado</h3>
                    <p>
                        Mantén organizada la información de tus mascotas y
                        sus datos importantes.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="servicio-card">
                    <div class="servicio-icono">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3>Gestión de pacientes</h3>
                    <p>
                        Consulta y administra la información de clientes
                        y mascotas desde nuestro sistema.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- SECCIÓN FINAL -->
<section class="inicio-contacto" id="contacto">
    <div class="container">
        <div class="contacto-contenido text-center">
            <i class="bi bi-heart-fill contacto-icono"></i>

            <h2>Su salud, nuestra mayor alegría y PREOCUPACION.</h2>

            <p>
                Estamos construyendo un espacio dedicado al cuidado y
                bienestar de quienes llenan nuestros hogares de alegría.
            </p>

            <span class="contacto-aviso">
                <i class="bi bi-info-circle me-1"></i>
                El módulo de citas estará disponible próximamente.
            </span>
        </div>
    </div>
</section>