@page
@model Veterinaria.Web.Pages.Clientes.EditarModel
@{
    ViewData["Title"] = "Editar Cliente";
}

<h2>Editar cliente</h2>

<form method="post" class="card border-0 shadow-sm p-4">
    <input type="hidden" asp-for="Cliente.IdCliente" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Cliente.Nombre" class="form-label">Nombre</label>
            <input asp-for="Cliente.Nombre" class="form-control" />
            <span asp-validation-for="Cliente.Nombre" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Cliente.ApellidoPaterno" class="form-label">Apellido paterno</label>
            <input asp-for="Cliente.ApellidoPaterno" class="form-control" />
            <span asp-validation-for="Cliente.ApellidoPaterno" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Cliente.ApellidoMaterno" class="form-label">Apellido materno</label>
            <input asp-for="Cliente.ApellidoMaterno" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Cliente.Telefono" class="form-label">Teléfono</label>
            <input asp-for="Cliente.Telefono" class="form-control" />
            <span asp-validation-for="Cliente.Telefono" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Cliente.Correo" class="form-label">Correo</label>
            <input asp-for="Cliente.Correo" class="form-control" />
            <span asp-validation-for="Cliente.Correo" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Cliente.Direccion" class="form-label">Dirección</label>
            <input asp-for="Cliente.Direccion" class="form-control" />
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary">Guardar cambios</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}